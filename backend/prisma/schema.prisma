generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  email        String?  @default("")
  passwordHash String
  createdAt    DateTime @default(now())
}

model Settings {
  id             Int      @id @default(1)
  claudePrompt   String   @db.Text
  binanceApiKey  String   @default("")
  binanceSecret  String   @default("")
  telegramToken  String?
  telegramChatId String?
  dipThreshold   Float    @default(10)
  minConfidence  Int      @default(65)
  autoTrade      Boolean  @default(false)
  autoTradeAmount Float   @default(10)
  maxOpenTrades  Int      @default(1)
  allowShort     Boolean  @default(true)
  promptHash     String   @default("")
  exchange       String   @default("binance")
  bybitApiKey    String   @default("")
  bybitSecret    String   @default("")
  ofiEnabled     Boolean  @default(false)
  ofiClaudePrompt String  @default("") @db.Text
  ofiPromptHash  String   @default("")
  updatedAt      DateTime @updatedAt
}

model TradingPair {
  id            Int           @id @default(autoincrement())
  monitorSymbol String
  tradeSymbol   String
  isActive      Boolean       @default(true)
  timeframe     String        @default("1m")
  createdAt     DateTime      @default(now())
  signals       Signal[]
  obdSnapshots  ObdSnapshot[]
}

model ObdSnapshot {
  id        Int         @id @default(autoincrement())
  pairId    Int
  pair      TradingPair @relation(fields: [pairId], references: [id])
  obd1      Float
  obd2      Float
  obd3      Float
  obd4      Float
  midPrice  Float
  createdAt DateTime    @default(now())

  @@index([pairId, createdAt])
}

model Signal {
  id             Int         @id @default(autoincrement())
  pairId         Int
  pair           TradingPair @relation(fields: [pairId], references: [id])
  direction      String
  confidence     Float?
  strategy       String      @default("OBD")
  ofiRatio       Float?
  obd1           Float?
  obd2           Float?
  obd3           Float?
  obd4           Float?
  price          Float
  claudeAnalysis String      @db.Text
  suggestedSl    Float?
  suggestedTp    Float?
  rsi            Float?   // RSI(14) на 1m в момент сигнала
  trend5m        String?  // UP | DOWN | FLAT
  trend15m       String?  // UP | DOWN | FLAT
  atr            Float?   // ATR(14) на 15m в абсолютных единицах
  atrPct         Float?   // ATR(14) на 15m в % от цены
  tpPct          Float?   // TP расстояние в % от цены входа
  slPct          Float?   // SL расстояние в % от цены входа
  outcome        String?     // WIN | LOSS | BREAKEVEN | PENDING
  outcomePrice   Float?      // цена при закрытии/срабатывании SL/TP
  outcomePnl     Float?      // P&L в процентах
  outcomeAt      DateTime?   // когда сработал SL/TP
  maxPrice       Float?      // максимальная цена после сигнала
  minPrice       Float?      // минимальная цена после сигнала
  createdAt      DateTime    @default(now())

  @@index([createdAt])
}

model Trade {
  id             Int       @id @default(autoincrement())
  signalId       Int?
  symbol         String
  side           String
  quantity       Float
  price          Float
  stopLoss       Float?
  takeProfit     Float?
  binanceOrderId String
  status         String    @default("OPEN")
  slOrderFailed  Boolean   @default(false)
  pnl            Float?
  createdAt      DateTime  @default(now())
  closedAt       DateTime?

  @@index([symbol, status])
}
